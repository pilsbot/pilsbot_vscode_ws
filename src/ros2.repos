# Common Pilsbot sources: needed on the desktop and in the Nano's stack container.
# See https://github.com/dirk-thomas/vcstool and docs/adr/0003-two-container-nano-runtime.md
#
# Third-party packages with Humble binaries are NOT listed here; rosdep installs them:
#   ackermann_msgs, nmea_navsat_driver, tf_transformations, depthai_descriptions,
#   joy, ros2_control / ros2_controllers, foxglove_bridge, ...
#
# Own repos track `humble` (docs/adr/0001-humble-primary-foxy-backports.md).
# teleop_acker_joy stays on `foxy` until its old upstream `humble` is replaced.
repositories:
  pilsbot_hw_ros:
    type: git
    url: https://github.com/pilsbot/pilsbot_hw_ros.git
    version: humble
  pilsbot_control:
    type: git
    url: https://github.com/pilsbot/pils_control.git
    version: humble
  pilsbot_navigation:
    type: git
    url: https://github.com/pilsbot/pilsbot_navigation.git
    version: humble
  pilsbot_description:
    type: git
    url: https://github.com/pilsbot/pilsbot_description.git
    version: humble
  MCP23017_i2c_portexpander:
    type: git
    url: https://github.com/pilsbot/MCP23017_i2c_portexpander.git
    version: humble
  pilsbot_gnss_receiver:
    type: git
    url: https://github.com/pilsbot/pilsbot_gnss_receiver.git
    version: humble
  pilsbot_bringup:
    type: git
    url: https://github.com/pilsbot/pilsbot_bringup.git
    version: humble
  teleop_acker_joy:
    type: git
    url: https://github.com/pilsbot/teleop_acker_joy.git
    version: foxy
  # Third-party forks without Humble binaries
  ds4drv:
    type: git
    url: https://github.com/pilsbot/ds4drv.git
    version: devel
  ds4_driver:
    type: git
    url: https://github.com/pilsbot/ds4_driver.git
    version: humble-devel
