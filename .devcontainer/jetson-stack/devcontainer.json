// Nano stack container. Setup inside: ./setup.sh src/ros2.repos && ./build.sh
{
	"name": "Pilsbot Nano stack (Humble, official image)",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}"
		}
	},
	"remoteUser": "ros",
	"runArgs": [
		"--network=host",
		"--ipc=host",
		"--cap-add=SYS_PTRACE",
		// JetPack 4.6's Docker lacks clone3 in its seccomp profile, which breaks 22.04 images
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		"--volume=/dev:/dev",
		// SDL (Humble's joy_node) watches udev for gamepad hotplug
		"--volume=/run/udev:/run/udev:ro",
		// --privileged opens the device cgroup but grants no file access to the non-root user:
		// /dev/input/event* (gamepad) and /dev/i2c-* belong to the HOST's input and i2c groups.
		// Export their gids before opening the container, e.g.
		//   export PILSBOT_INPUT_GID=$(getent group input | cut -d: -f3)
		//   export PILSBOT_I2C_GID=$(getent group i2c | cut -d: -f3)
		// Unset, the image's own groups are used, which do not match the host's.
		"--group-add=${localEnv:PILSBOT_INPUT_GID:input}",
		"--group-add=${localEnv:PILSBOT_I2C_GID:i2c}",
		// --mount, unlike --volume, refuses to start when the SSD is not mounted, instead of
		// recording into an empty directory on the Nano's root file system
		"--mount=type=bind,source=/media/externSSD/bags,target=/workspaces/bags",
		"--privileged"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"althack.ament-task-provider",
				"ms-python.python",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools",
				"Ranch-Hand-Robotics.rde-ros-2",
				"redhat.vscode-yaml"
			]
		}
	}
}
